# Site
# Local: http://localhost:3000
# Vercel Production (main): https://ocdemchudinh.vercel.app
# Vercel Staging (develop): https://ocdemchudinh-preview.vercel.app
# Branch alias / preview PR: xem docs/DEPLOY.md
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Liên hệ chính (hiển thị trên website)
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_EMAIL=

# Link ngoài — nút nổi & footer
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Google Maps — link chỉ đường từng chi nhánh (tùy chọn, ghi đè URL mặc định)
NEXT_PUBLIC_MAP_CN1_URL=
NEXT_PUBLIC_MAP_CN2_URL=
NEXT_PUBLIC_MAP_CN3_URL=
NEXT_PUBLIC_MAP_CN4_URL=
NEXT_PUBLIC_MAP_CN5_URL=

# Google Maps — iframe embed (tùy chọn, ghi đè embed mặc định từ địa chỉ chi nhánh)
NEXT_PUBLIC_MAP_EMBED_CN1=
NEXT_PUBLIC_MAP_EMBED_CN2=
NEXT_PUBLIC_MAP_EMBED_CN3=
NEXT_PUBLIC_MAP_EMBED_CN4=
NEXT_PUBLIC_MAP_EMBED_CN5=

# Site assets — bật sau khi chạy scripts/migrate-site-images.mjs
NEXT_PUBLIC_USE_SUPABASE_ASSETS=false

# Form — gửi email qua Resend (đặt bàn + liên hệ)
# Sandbox (chưa verify domain):
#   BOOKING_FROM_EMAIL=onboarding@resend.dev
#   BOOKING_NOTIFICATION_EMAIL=email đăng ký tài khoản Resend
# Production: verify domain trên Resend → đổi FROM thành noreply@yourdomain.com
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL=onboarding@resend.dev

# Supabase (v2 — content system)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bắt buộc để lưu form đặt bàn / đặt tiệc / tuyển dụng vào Supabase
SUPABASE_SERVICE_ROLE_KEY=
